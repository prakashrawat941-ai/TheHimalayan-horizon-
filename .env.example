# Copy to .env and fill in your own values.
# NEXT_PUBLIC_ values are visible in the browser, so only public values go there.
# Never commit .env, and never put a service-role key or any other secret in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
